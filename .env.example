# --- Required -------------------------------------------------------------
# Postgres connection string (Neon, Supabase, ...). TLS certificates are verified.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signs login tokens. Use a long random value (32+ characters), e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Protects POST /api/init (schema setup). Send it in the X-Admin-Secret header.
ADMIN_SECRET=replace-with-a-long-random-secret

# Comma-separated usernames that can see the admin dashboard. Usernames are
# case-insensitive and unique, so nobody else can register a look-alike.
ADMIN_USERNAMES=comma,separated,admin,usernames

# --- Optional -------------------------------------------------------------
# Extra browser origins allowed to call the API (the site itself never needs this).
# ALLOWED_ORIGINS=https://staging.example.com

# Local development only
RUN_LOCAL=true
PORT=3001
# DATABASE_SSL_INSECURE=true   # only for a local database with a self-signed certificate
